#!/usr/bin/env bash
# wtciwait - poll a PR's CI checks at fixed times, then report.
# Usage: wtciwait <PR_URL>
#
# Poll schedule (cumulative): 5s, 30s, 90s, 5m (300s), 10m (600s).
# Uses: gh pr checks <PR_URL> --json name,bucket --jq '.[] | [.bucket, .name] | @tsv'
#
# Outcomes (ASCII stdout, then exit):
#   PASSED                       exit 0  all checks pass (or skipped)
#   NO_CHECKS                    exit 0  repo has no CI (no checks ever appear)
#   MERGED                       exit 0  PR was merged (detected during poll)
#   PR_CLOSED                    exit 1  PR was closed without merging
#   FAILED: <name>, <name>       exit 1  one or more checks failed (or needs action)
#   TIMEOUT: <name>, <name>      exit 1  still pending/unknown after the last poll
#   ERROR: <reason>              exit 1  gh itself failed (auth/network/not found)
#
# gh returns exit 1 for BOTH the "no checks reported" sentence (legit no-CI on
# this repo) AND real failures (bad credentials, network, PR not found). It
# cannot be told apart by exit code alone, so we read stderr: the no-CI sentence
# -> NO_CHECKS; anything else -> ERROR (which is exit 1, never a silent pass).
# Capture stdout and stderr separately so an error string is never mistaken for
# "no CI" (the pre-fix bug: any gh failure ~silently passed review after 90s).
# JSON is parsed by gh's own --jq, so the result is robust to nested objects and
# whitespace (the pre-fix awk splitter broke on those).
set -u

if [ $# -ne 1 ]; then
  echo "wtciwait: usage: wtciwait <PR_URL>"
  exit 1
fi

PR_URL="$1"

POLL_AT=(5 30 90 300 600)
PREV=0

# names_for <tsv-lines> <mode>: print comma-joined check names.
# Input is one "bucket<TAB>name" line per check (already produced by gh --jq).
# mode = fail    -> checks that are NOT pass/skipping/pending (failure-like)
# mode = pending -> checks still pending
names_for() {
  local lines="$1" mode="$2"
  case "$mode" in
    fail)
      printf '%s\n' "$lines" | awk -F'\t' '$1!="" && $1!="pass" && $1!="skipping" && $1!="pending" && $1!="queued" && $1!="waiting" {print $2}' ;;
    pending)
      printf '%s\n' "$lines" | awk -F'\t' '$1=="pending" || $1=="queued" || $1=="waiting" {print $2}' ;;
  esac | paste -sd ', ' -
}

# classify_lines <tsv-lines>: set global STATUS = PASSED | FAILED | PENDING and
# print a one-line summary. Caller guarantees $lines is non-empty.
classify_lines() {
  local lines="$1"
  local total pass skip pending other
  total=$(printf '%s\n' "$lines" | grep -c '')
  pass=$(printf '%s\n'   "$lines" | awk -F'\t' '$1=="pass"     {c++} END{print c+0}')
  skip=$(printf '%s\n'   "$lines" | awk -F'\t' '$1=="skipping" {c++} END{print c+0}')
  pending=$(printf '%s\n' "$lines" | awk -F'\t' '$1=="pending" || $1=="queued" || $1=="waiting" {c++} END{print c+0}')
  # anything that is neither passing, skipped, nor pending/queued/waiting = a
  # failure-like state (fail / action_required / blocking / cancelled / ...).
  other=$(( total - pass - skip - pending ))

  if [ "$other" -gt 0 ]; then
    STATUS="FAILED"; echo "ci: checks total=$total pass=$pass fail=$other pending=$pending"; return 0
  fi
  if [ "$pending" -gt 0 ]; then
    STATUS="PENDING"; echo "ci: checks total=$total pass=$pass pending=$pending"; return 0
  fi
  STATUS="PASSED"; echo "ci: checks total=$total pass=$pass"
  return 0
}

# contains_no_checks <text>: gh's own "no CI" sentence (stable across versions).
contains_no_checks() {
  printf '%s' "$1" | grep -qi 'no checks reported'
}

STATUS=""          # PASSED | FAILED | PENDING | NO_CHECKS | ERROR (last poll's verdict)
LAST_LINES=""      # tsv from the last poll that actually had checks
LAST_ERR=""        # last gh error message (for the final ERROR line)
NO_CHECKS_STREAK=0
ERROR_STREAK=0
# If "no checks reported" persists across this many polls, conclude the repo has
# no CI rather than waiting the full 10 minutes (CI normally registers within
# the first ~90s).
NO_CHECKS_MAX=3
# If gh itself fails on this many consecutive polls, stop early with ERROR
# (auth/network is broken; no point waiting 10 more minutes).
ERROR_MAX=2

ERRFILE=$(mktemp 2>/dev/null) || { echo "wtciwait: cannot create temp file"; exit 1; }
trap 'rm -f "$ERRFILE"' EXIT

for at in "${POLL_AT[@]}"; do
  sleep $(( at - PREV ))
  PREV=$at

  # Check PR lifecycle state before polling CI.
  PR_STATE=$(gh pr view "$PR_URL" --json state --jq '.state' 2>/dev/null) || true
  case "$PR_STATE" in
    MERGED) echo "MERGED"; exit 0 ;;
    CLOSED) echo "PR_CLOSED"; exit 1 ;;
    '')
      # gh pr view failed (auth/network). Count toward ERROR_STREAK so the
      # next gh pr checks failure will trigger an early exit with a clearer message.
      ERROR_STREAK=$(( ERROR_STREAK + 1 ))
      echo "ci: poll @$at -> gh pr view failed (auth/network?)"
      if [ "$ERROR_STREAK" -ge "$ERROR_MAX" ]; then
        echo "ERROR: gh pr view failed - cannot read PR state (auth/network issue?)"
        exit 1
      fi
      # Skip the gh pr checks call this round — it would fail the same way.
      continue
      ;;
  esac

  OUT=$(gh pr checks "$PR_URL" --json name,bucket --jq '.[] | [.bucket, .name] | @tsv' 2>"$ERRFILE")
  RC=$?
  ERR="$(cat "$ERRFILE")"

  if [ "$RC" -ne 0 ] && ! contains_no_checks "$ERR$OUT"; then
    # gh failed and it is NOT the no-CI sentence: real error (auth/network/...).
    # This must NOT become NO_CHECKS/PASSED (would silently pass review).
    STATUS="ERROR"
    LAST_ERR="${ERR:-gh exited $RC with no message}"
    ERROR_STREAK=$(( ERROR_STREAK + 1 ))
    echo "ci: poll @$at -> ERROR (gh failed)"
    if [ "$ERROR_STREAK" -ge "$ERROR_MAX" ]; then
      echo "ERROR: gh check failed - $LAST_ERR"
      exit 1
    fi
    # Otherwise try again at the next scheduled poll.
    continue
  fi

  ERROR_STREAK=0
  # rc==0 with checks -> OUT is the tsv. rc==0/1 with the no-CI sentence or empty
  # OUT -> the repo has no CI this round.
  if [ -n "$OUT" ]; then
    classify_lines "$OUT"
    LAST_LINES="$OUT"
  else
    STATUS="NO_CHECKS"; LAST_LINES=""
    echo "ci: no checks reported"
  fi
  echo "ci: poll @$at -> $STATUS"

  case "$STATUS" in
    PASSED)
      echo "PASSED"
      exit 0 ;;
    FAILED)
      NAMES=$(names_for "$LAST_LINES" fail)
      echo "FAILED: $NAMES"
      exit 1 ;;
    NO_CHECKS)
      NO_CHECKS_STREAK=$(( NO_CHECKS_STREAK + 1 ))
      if [ "$NO_CHECKS_STREAK" -ge "$NO_CHECKS_MAX" ]; then
        echo "NO_CHECKS"
        exit 0
      fi
      # CI may not have registered yet; wait for the next fixed poll.
      ;;
    PENDING)
      # keep waiting for the next poll
      ;;
    ERROR)
      # surfaced above; unreachable here, kept for completeness
      ;;
  esac
done

# Reached the end of the schedule.
if [ "$STATUS" = "NO_CHECKS" ]; then
  echo "NO_CHECKS"
  exit 0
fi
if [ "$STATUS" = "ERROR" ]; then
  echo "ERROR: gh check failed - $LAST_ERR"
  exit 1
fi

NAMES=$(names_for "$LAST_LINES" pending)
if [ -z "$NAMES" ]; then
  echo "TIMEOUT: (no names available)"
else
  echo "TIMEOUT: $NAMES"
fi
exit 1
