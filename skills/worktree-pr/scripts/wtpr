#!/usr/bin/env bash
# wtpr - open a pull request from a worktree's branch.
# Usage: wtpr <wt-path> <base-branch> <title> <body>
#
# <title> and <body> may be multi-line. Prefix either with '@' to instead read
# its content from a file (handles quotes/long bodies cleanly).
# Prints the new PR URL on success.
# ASCII stdout.
set -u

if [ $# -ne 4 ]; then
  echo "wtpr: usage: wtpr <wt-path> <base-branch> <title> <body>"
  exit 1
fi

WT_PATH="$1"
BASE="$2"
TITLE_ARG="$3"
BODY_ARG="$4"

if [ ! -d "$WT_PATH" ]; then
  echo "wtpr: worktree path not found: $WT_PATH"
  exit 1
fi

# Resolve a value that may be a literal or a "@file" reference.
resolve_val() {
  local v="$1"
  case "$v" in
    @*)
      local f="${v#@}"
      if [ ! -f "$f" ]; then
        echo "wtpr: file not found: $f" >&2
        return 1
      fi
      cat -- "$f"
      ;;
    *)
      printf '%s' "$v"
      ;;
  esac
}

TITLE=$(resolve_val "$TITLE_ARG") || { echo "wtpr: bad title"; exit 1; }
BODY=$(resolve_val "$BODY_ARG") || { echo "wtpr: bad body"; exit 1; }

if [ -z "$TITLE" ]; then
  echo "wtpr: title is empty"
  exit 1
fi

# Write body to a temp file so gh always gets the exact content regardless of
# newlines/quotes.
BODY_FILE=$(mktemp) || { echo "wtpr: mktemp failed"; exit 1; }
trap 'rm -f -- "$BODY_FILE"' EXIT
printf '%s' "$BODY" > "$BODY_FILE"

if ! cd "$WT_PATH"; then
  echo "wtpr: cannot enter worktree: $WT_PATH"
  exit 1
fi

URL=$(gh pr create --base "$BASE" --title "$TITLE" --body-file "$BODY_FILE" 2>&1)
RC=$?

if [ $RC -ne 0 ]; then
  echo "wtpr: gh pr create failed"
  echo "$URL"
  exit 1
fi

echo "wtpr: created PR: $URL"
exit 0
